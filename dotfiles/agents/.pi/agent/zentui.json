{
  "colors": {
    "cost": "syntaxString",
    "contextNormal": "syntaxNumber",
    "cwd": "syntaxType",
    "editorGitBranch": "syntaxKeyword",
    "editorModel": "syntaxFunction",
    "editorThinkingMedium": "thinkingText",
    "gitStatus": "error"
  },
  "components": {
    "editor": {
      "style": "minimalist",
      "styles": {
        "minimalist": {
          "contextFormat": "tokens",
          "pathDisplay": "compact",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": true,
          "showCost": true,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        },
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        }
      },
      "enabled": true,
      "colorSource": "theme",
      "borderColorMode": "static",
      "modelLabel": "id",
      "viewportIndicators": true
    },
    "footer": {
      "style": "starship",
      "styles": {
        "starship": {
          "segments": {
            "cwd": false,
            "gitBranch": false,
            "gitStatus": false,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "context": false,
            "tokens": false,
            "cost": false,
            "sessionName": true,
            "runtime": true,
            "modelInfo": false,
            "sessionDuration": false,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "extensionStatuses": {
            "defaultPlacement": "left",
            "placements": {
              "codex-usage": "right",
              "monthly-cost": "off"
            },
            "colorModes": {
              "active-workflow": "original",
              "monthly-cost": "original"
            }
          },
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
          "compactMaxLines": 2,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          }
        }
      },
      "colorSource": "theme",
      "modelLabel": "id"
    },
    "userMessages": {
      "enabled": true,
      "style": "framed",
      "colorSource": "theme",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "workingLine": {
      "enabled": false,
      "turnSummary": true,
      "spinner": "star-bloom",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "classic",
      "colorSource": "theme",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "theme"
    }
  }
}
