{
  "//": "Typecheck only — nothing here is built. Pi loads the .ts sources directly, so this exists to give the editor LSP and `bin/check.sh` a correct view of the extensions.",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "dotfiles/agents/.pi/agent/extensions/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "dotfiles/agents/.pi/agent/packages/**"
  ]
}
